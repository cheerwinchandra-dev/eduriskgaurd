{
  "name": "eduguard",
  "version": "1.0.0",
  "description": "EduGuard desktop shell and deployment workspace",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on tcp:5173 && cross-env EDUGUARD_DEV=1 electron .\"",
    "build": "npm --prefix frontend run build",
    "start": "electron .",
    "web": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "check": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
